<Window x:Class="FolderGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderGuard.Views"
        Title="FolderGuard"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="/Resources/AppIcon.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/AppLogo.png"
                       Width="40"
                       Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FolderGuard" Style="{StaticResource TitleText}" />
                    <TextBlock Text="Password-protected NTFS folder access"
                               Style="{StaticResource CaptionText}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="12"
                    Padding="12,5">
                <TextBlock x:Name="AdminChip"
                           Text="Administrator"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>
        </Grid>

        <!-- Banner -->
        <Border x:Name="Banner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource BannerInfoBrush}"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerText"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource BannerInfoTextBrush}" />
                <Button Grid.Column="1"
                        Content="Dismiss"
                        Style="{StaticResource LinkButton}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="DismissBanner_Click" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Protect a folder" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,14"
                                   Text="Pick any folder on an NTFS drive. FolderGuard changes only that folder's NTFS permissions — it never moves, hides or encrypts your files." />
                        <views:SetupView x:Name="Setup" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Protected folders" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CountText"
                                       Text="None"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListView x:Name="FolderList"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="0"
                                      ItemContainerStyle="{StaticResource FolderListItemStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionChanged="FolderList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" CornerRadius="8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PathText}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="{Binding StatusBackground}"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel x:Name="EmptyState"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="No folders protected yet"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Choose a folder above and press Protect Folder."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right column -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Selected folder" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Border x:Name="StatusPill"
                                        Background="{StaticResource PillLockedBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="10,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText"
                                               Text="Not Protected"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PillLockedTextBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="SelectedName"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,12,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="SelectedPath"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="SelectedMeta"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />

                            <StackPanel x:Name="NoSelection" Margin="0,10,0,0">
                                <TextBlock Text="Select a protected folder in the list to unlock, lock or manage it."
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="ActionsPanel" Visibility="Collapsed">
                                <TextBlock Text="Password"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,16,0,5" />
                                <views:PasswordField x:Name="FolderPassword" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="UnlockButton"
                                            Content="Unlock"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="Unlock_Click" />
                                    <Button x:Name="LockButton"
                                            Grid.Column="2"
                                            Content="Lock"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="Lock_Click" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Change Password"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ChangePassword_Click" />
                                    <Button Grid.Column="2"
                                            Content="Remove Protection"
                                            Style="{StaticResource DangerButton}"
                                            Click="RemoveProtection_Click" />
                                </Grid>

                                <TextBlock x:Name="ActionMessage"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <views:SettingsView x:Name="Settings" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusLabel"
                   Grid.Row="3"
                   Style="{StaticResource CaptionText}"
                   Margin="2,14,0,0"
                   Text="Ready." />
    </Grid>
</Window>
