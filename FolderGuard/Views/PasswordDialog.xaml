<Window x:Class="FolderGuard.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderGuard.Views"
        Title="FolderGuard"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Padding="24,22,24,20">
        <StackPanel>
            <TextBlock x:Name="TitleBlock" Style="{StaticResource TitleText}" FontSize="20" Text="Enter password" />

            <TextBlock x:Name="DescriptionBlock"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,16" />

            <TextBlock x:Name="CurrentLabel" Text="Password" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
            <views:PasswordField x:Name="CurrentInput" />

            <StackPanel x:Name="NewPasswordPanel" Visibility="Collapsed">
                <TextBlock Text="New password" Style="{StaticResource CaptionText}" Margin="0,10,0,6" />
                <views:PasswordField x:Name="NewInput" />

                <TextBlock Text="Confirm new password" Style="{StaticResource CaptionText}" Margin="0,10,0,6" />
                <views:PasswordField x:Name="ConfirmInput" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="ConfirmButton"
                        Content="Continue"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
