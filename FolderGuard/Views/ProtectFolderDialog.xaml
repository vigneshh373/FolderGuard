<Window x:Class="FolderGuard.Views.ProtectFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderGuard.Views"
        Title="Protect folder"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Padding="24,22,24,20">
        <StackPanel>
            <TextBlock Text="Protect this folder" Style="{StaticResource TitleText}" FontSize="20" />

            <TextBlock Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,14"
                       Text="FolderGuard saves the current NTFS permissions, then applies a locked permission set. The folder stays visible in File Explorer, but its contents cannot be opened without the password." />

            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <TextBlock x:Name="PathText"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <TextBlock Text="Password for this folder" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
            <views:PasswordField x:Name="PasswordInput" />

            <TextBlock Text="Confirm password" Style="{StaticResource CaptionText}" Margin="0,10,0,6" />
            <views:PasswordField x:Name="ConfirmInput" />

            <TextBlock Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Text="Minimum 8 characters. The password cannot be recovered if it is forgotten; you would have to reset the folder permissions manually." />

            <CheckBox x:Name="UnderstandCheck"
                      Margin="0,14,0,0"
                      FontSize="12"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      Content="I understand that this changes the NTFS permissions of this folder and its subfolders." />

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Protect Folder"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Protect_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
